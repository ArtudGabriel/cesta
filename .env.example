# === Docker Compose (postgres + redis — local dev) ===
POSTGRES_USER=cesta
POSTGRES_PASSWORD=change_me_dev
POSTGRES_DB=cesta_dev
POSTGRES_PORT=5432
REDIS_PORT=6379

# === cesta-api (NestJS) ===
NODE_ENV=development
PORT=3001

# URL do frontend permitido via CORS.
# Prod: https://seu-app.vercel.app
CORS_ORIGIN=http://localhost:3000

# Prisma / Postgres
# Dev: docker compose up; usa POSTGRES_PORT acima
# Neon prod format: postgresql://user:pass@ep-xxx-xxx.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://cesta:change_me_dev@localhost:5432/cesta_dev?schema=public

# JWT secrets — mínimo 32 chars validado por env.validation.ts
# Prod: openssl rand -hex 32 (ou node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=replace_with_64_byte_hex
JWT_REFRESH_SECRET=replace_with_different_64_byte_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis / BullMQ
# Dev: docker compose up; usa REDIS_PORT acima
# Upstash prod format: rediss://default:token@endpoint.upstash.io:6380
REDIS_URL=redis://localhost:6379

# Web Push (opcional — se "disabled" o worker de notifications vira no-op)
# Gerar prod: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=disabled
VAPID_PRIVATE_KEY=disabled
VAPID_SUBJECT=mailto:contact@cesta.app

# Sentry (opcional — se vazio, SDK vira no-op e app roda normal)
# Prod: criar projeto em sentry.io, copiar DSN do projeto NestJS
SENTRY_DSN=

# URL do frontend Next.js — usada pelo RevalidateService pra invalidar cache
# SSR após catalog-sync. Se vazio, revalidate vira no-op silencioso.
# Prod exemplo: https://cesta.vercel.app
WEB_URL=http://localhost:3000

# Secret compartilhado com cesta-web pra autenticar POST /api/revalidate.
# Precisa ter o mesmo valor em ambos (api + web) services.
# Prod: openssl rand -hex 32
REVALIDATE_SECRET=change-in-prod-via-openssl-rand-hex-32

# === cesta-web (Next.js) ===
# Server-only — fora do bundle client, usada pelos fetches SSR (RSC).
# Prod exemplo: https://cesta-api.onrender.com/api/v1 (ou URL interna Render)
API_URL=http://localhost:3001/api/v1

# Client-only (vaza no bundle) — usada pelas calls browser-side (axios).
# Prod: URL publica da API no Render, ex https://cesta-api.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Sentry frontend (opcional — DSN do projeto Next.js separado do backend)
NEXT_PUBLIC_SENTRY_DSN=
