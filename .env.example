# === Docker Compose (postgres + redis) ===
POSTGRES_USER=cesta
POSTGRES_PASSWORD=change_me_dev
POSTGRES_DB=cesta_dev
POSTGRES_PORT=5432
REDIS_PORT=6379

# === cesta-api (NestJS) ===
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Prisma / Postgres
DATABASE_URL=postgresql://cesta:change_me_dev@localhost:5432/cesta_dev?schema=public

# JWT (gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=replace_with_64_byte_hex
JWT_REFRESH_SECRET=replace_with_different_64_byte_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Web Push (gerar com: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=replace_with_vapid_public
VAPID_PRIVATE_KEY=replace_with_vapid_private
VAPID_SUBJECT=mailto:contact@cesta.app

# === cesta-web (Next.js) ===
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
