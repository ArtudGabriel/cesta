# === Docker Compose (postgres + redis — local dev) ===
POSTGRES_USER=cesta
POSTGRES_PASSWORD=change_me_dev
POSTGRES_DB=cesta_dev
POSTGRES_PORT=5432
REDIS_PORT=6379

# === cesta-api (NestJS) ===
NODE_ENV=development
PORT=3001

# URL do frontend permitido via CORS.
# Prod: https://seu-app.vercel.app
CORS_ORIGIN=http://localhost:3000

# Sprint 87: team slug Vercel usado pra montar regex dinâmica de preview URL.
# Padrão da preview: https://cesta-web-git-<branch>-<VERCEL_TEAM_SLUG>.vercel.app
# Pegar no dashboard Vercel → Settings → General → Team Slug.
VERCEL_TEAM_SLUG=gabriels-projects-f5aa3b24

# Prisma / Postgres
# Dev: docker compose up; usa POSTGRES_PORT acima
# Neon prod format: postgresql://user:pass@ep-xxx-xxx-pooler.neon.tech/dbname?sslmode=require (pooled runtime)
DATABASE_URL=postgresql://cesta:change_me_dev@localhost:5432/cesta_dev?schema=public

# Sprint 183 (ADR 0013): directUrl for prisma migrate (bypass pgbouncer).
# PROD: NOT set manually — render-build.sh derives it from DATABASE_URL
#       at build time (strip "-pooler", append ?connect_timeout=30).
# CI / local: set to the same URL as DATABASE_URL (the derivation is a
#             no-op without "-pooler" in the host).
DATABASE_URL_UNPOOLED=postgresql://cesta:change_me_dev@localhost:5432/cesta_dev?schema=public

# JWT secrets — mínimo 32 chars validado por env.validation.ts
# Prod: openssl rand -hex 32 (ou node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=replace_with_64_byte_hex
JWT_REFRESH_SECRET=replace_with_different_64_byte_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis / BullMQ
# Dev: docker compose up; usa REDIS_PORT acima
# Upstash prod format: rediss://default:token@endpoint.upstash.io:6380
REDIS_URL=redis://localhost:6379

# Web Push (opcional — se "disabled" o worker de notifications vira no-op)
# Gerar prod: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=disabled
VAPID_PRIVATE_KEY=disabled
VAPID_SUBJECT=mailto:contact@cesta.app

# Resend — email transacional (Sprint 75). "disabled" = EmailService vira no-op
# (log em dev, nenhuma mensagem enviada). Prod: criar API key em resend.com e
# verificar domínio antes de usar FROM custom.
RESEND_API_KEY=disabled
RESEND_FROM=Cesta <noreply@cesta.app>

# URL base do frontend pra montar link de confirmação (Sprint 75).
# Prod: https://cesta-web.vercel.app ou domínio custom.
EMAIL_VERIFY_BASE_URL=http://localhost:3000

# Sprint 94: hora UTC do cron grace-reminder (0-23). Default 9 (10h Madrid
# standard / 11h DST). Email vai pra users soft-deleted quando faltam 7d ou
# 1d pro hard-delete.
CRON_GRACE_REMINDER_HOUR=9

# Sentry (opcional — se vazio, SDK vira no-op e app roda normal)
# Prod: criar projeto em sentry.io, copiar DSN do projeto NestJS
SENTRY_DSN=

# Sentry Performance tracing (Sprint 55). 0.0 = off, 1.0 = 100%, prod default 10%.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Profiling exige plano pago Sentry — manter 0 salvo opt-in explícito.
SENTRY_PROFILES_SAMPLE_RATE=0

# URL do frontend Next.js — usada pelo RevalidateService pra invalidar cache
# SSR após catalog-sync. Se vazio, revalidate vira no-op silencioso.
# Prod exemplo: https://cesta-web.vercel.app
WEB_URL=http://localhost:3000

# Secret compartilhado com cesta-web pra autenticar POST /api/revalidate.
# Precisa ter o mesmo valor em ambos (api + web) services.
# Prod: openssl rand -hex 32
REVALIDATE_SECRET=change-in-prod-via-openssl-rand-hex-32

# === cesta-web (Next.js) ===
# Server-only — fora do bundle client, usada pelos fetches SSR (RSC).
# Prod exemplo: https://cesta-api.onrender.com/api/v1 (ou URL interna Render)
API_URL=http://localhost:3001/api/v1

# Client-only (vaza no bundle) — usada pelas calls browser-side (axios).
# Prod: URL publica da API no Render, ex https://cesta-api.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Sentry frontend (opcional — DSN do projeto Next.js separado do backend)
NEXT_PUBLIC_SENTRY_DSN=

# Sentry Performance tracing frontend (Sprint 55). Mesma escala do backend.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Sentry Session Replay (Sprint 58). Default 5% das sessões + 100% on-error.
# Privacy: inputs mascarados, mídia bloqueada.
NEXT_PUBLIC_SENTRY_REPLAY_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1.0

# URL base pública — robots.ts, sitemap.ts, OG metadata (Sprint 69), JSON-LD
# canonical e opengraph-image dinâmica (Sprint 88).
# Prod: https://cesta-web.vercel.app (ou domínio custom). Vercel: setar como
# Production env var. Fallback hardcoded aponta pra cesta-web.vercel.app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry source maps upload (Sprint 55) — usados SÓ em CI build (NÃO runtime).
# Dev local: deixar vazio → build sem upload. CI/Vercel: setar como secret.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
