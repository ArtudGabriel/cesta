# Minimal env for `jest --ci` + `prisma migrate deploy` in CI/local test runs.
# Copy to `.env.test` or export inline. Values are dummy — not valid in prod.

NODE_ENV=test
PORT=3001
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cesta_test
REDIS_URL=redis://localhost:6379

# Sprint 92 rotação: CURRENT obrigatório; PREVIOUS opcional durante overlap.
# ≥32 chars required by env.validation.
JWT_ACCESS_SECRET_CURRENT=ci_access_secret_32_chars_minimum_abc
JWT_REFRESH_SECRET_CURRENT=ci_refresh_secret_32_chars_minimum_xyz
# JWT_ACCESS_SECRET_PREVIOUS=
# JWT_REFRESH_SECRET_PREVIOUS=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

VAPID_PUBLIC_KEY=disabled
VAPID_PRIVATE_KEY=disabled
VAPID_SUBJECT=mailto:contact@cesta.app
