// Cesta API — schema Prisma
// Padrões: models PascalCase singular, @@map snake_case plural, @map snake_case.
// Todo model com id, createdAt, updatedAt, deletedAt? (soft delete).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// Auth
// ──────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String?   @unique
  phone        String?   @unique
  passwordHash String    @map("password_hash")
  name         String?
  locale       String    @default("es") // "es" | "pt-BR"
  roles        String[]  @default(["user"])

  // Preferências dietéticas (Sprint 18)
  prefersVegan       Boolean @default(false) @map("prefers_vegan")
  prefersVegetarian  Boolean @default(false) @map("prefers_vegetarian")
  prefersGlutenFree  Boolean @default(false) @map("prefers_gluten_free")
  prefersLactoseFree Boolean @default(false) @map("prefers_lactose_free")

  // Preferencia sort unit price (Sprint 28)
  sortUnitPreference String @default("absolute") @map("sort_unit_preference")

  // Preferências Nutri-Score (Sprint 34)
  nutriSortEnabled Boolean @default(false) @map("nutri_sort_enabled")
  nutriHealthyOnly Boolean @default(false) @map("nutri_healthy_only")

  // GDPR cookie consent (Sprint 62). null = banner ainda não respondido.
  cookiesAcceptedAt  DateTime? @map("cookies_accepted_at")
  cookieConsentLevel String?   @map("cookie_consent_level") // "all" | "essential"

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  refreshTokens      RefreshToken[]
  shoppingLists      ShoppingList[]
  reviews            Review[]
  reviewHelpfuls     ReviewHelpful[]
  familyProfile      FamilyProfile?
  familyBaskets      FamilyBasket[]
  receipts           Receipt[]
  priceDiscrepancies PriceDiscrepancy[]
  alerts             Alert[]
  pushSubscriptions  PushSubscription[]
  favorites          Favorite[]
  searchHistory      SearchHistory[]

  @@index([deletedAt])
  @@map("users")
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  query     String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, query])
  @@index([userId, createdAt(sort: Desc)])
  @@map("search_history")
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

// ──────────────────────────────────────────────
// Catálogo
// ──────────────────────────────────────────────

enum MeasureUnit {
  LITER        @map("liter")
  MILLILITER   @map("milliliter")
  KILOGRAM     @map("kilogram")
  GRAM         @map("gram")
  UNIT         @map("unit")

  @@map("measure_unit")
}

model Supermarket {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  color     String?  // hex da marca para badges
  logoUrl   String?  @map("logo_url")
  website   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  prices    ProductPrice[]
  snapshots PriceSnapshot[]
  receipts  Receipt[]
  alerts    Alert[]

  @@map("supermarkets")
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameEs    String    @map("name_es")
  namePt    String    @map("name_pt")
  parentId  String?   @map("parent_id")
  order     Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique @map("normalized_name") // slug para matching crowdsourced
  brand          String?
  description    String?
  imageUrl       String?  @map("image_url")
  ean            String?  @unique

  // Embalagem
  packageSize   Decimal     @db.Decimal(10, 3) @map("package_size")
  packageUnit   MeasureUnit @map("package_unit")

  // Unidade de comparação (ex: azeite vendido em 0.75L → compara por LITER)
  comparisonUnit MeasureUnit @map("comparison_unit")

  // Nutrição (por 100g ou 100ml, ou por unidade)
  nutritionPer Decimal? @db.Decimal(6, 2) @map("nutrition_per")
  calories     Decimal? @db.Decimal(7, 2)
  protein      Decimal? @db.Decimal(6, 2)
  carbs        Decimal? @db.Decimal(6, 2)
  sugar        Decimal? @db.Decimal(6, 2)
  fat          Decimal? @db.Decimal(6, 2)
  saturatedFat Decimal? @db.Decimal(6, 2) @map("saturated_fat")
  fiber        Decimal? @db.Decimal(6, 2)
  salt         Decimal? @db.Decimal(6, 2)

  // Tags dietéticas
  isVegan       Boolean @default(false) @map("is_vegan")
  isVegetarian  Boolean @default(false) @map("is_vegetarian")
  isGlutenFree  Boolean @default(false) @map("is_gluten_free")
  isLactoseFree Boolean @default(false) @map("is_lactose_free")

  categoryId String?   @map("category_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  category     Category?          @relation(fields: [categoryId], references: [id])
  prices       ProductPrice[]
  snapshots    PriceSnapshot[]
  listItems    ShoppingListItem[]
  reviews      Review[]
  basketItems  FamilyBasketItem[]
  receiptItems ReceiptItem[]
  alerts       Alert[]
  favorites    Favorite[]

  @@index([normalizedName])
  @@index([categoryId, deletedAt])
  @@index([brand])
  @@map("products")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@map("favorites")
}

model ProductPrice {
  id              String    @id @default(cuid())
  productId       String    @map("product_id")
  supermarketId   String    @map("supermarket_id")
  currentPrice    Decimal   @db.Decimal(10, 2) @map("current_price")
  previousPrice   Decimal?  @db.Decimal(10, 2) @map("previous_price")
  onPromotion     Boolean   @default(false) @map("on_promotion")
  promotionEnds   DateTime? @map("promotion_ends")
  confidenceScore Decimal   @db.Decimal(3, 2) @default(1.00) @map("confidence_score")
  source          String    @default("seed") // official_api|scraper|crowdsourced|folleto_ocr|seed
  isStale         Boolean   @default(false) @map("is_stale")
  isAvailable     Boolean   @default(true) @map("is_available")
  lastSyncedAt    DateTime  @default(now()) @map("last_synced_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  supermarket   Supermarket        @relation(fields: [supermarketId], references: [id])
  discrepancies PriceDiscrepancy[]

  @@unique([productId, supermarketId])
  @@index([supermarketId, lastSyncedAt])
  @@index([onPromotion, isAvailable])
  @@map("product_prices")
}

model PriceSnapshot {
  id            String   @id @default(cuid())
  productId     String   @map("product_id")
  supermarketId String   @map("supermarket_id")
  price         Decimal  @db.Decimal(10, 2)
  onPromotion   Boolean  @default(false) @map("on_promotion")
  source        String
  capturedAt    DateTime @default(now()) @map("captured_at")

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  supermarket Supermarket @relation(fields: [supermarketId], references: [id])

  @@index([productId, supermarketId, capturedAt])
  @@map("price_snapshots")
}

// ──────────────────────────────────────────────
// Minha Lista (listas recorrentes do usuário)
// ──────────────────────────────────────────────

model ShoppingList {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ShoppingListItem[]

  @@index([userId, deletedAt])
  @@map("shopping_lists")
}

model ShoppingListItem {
  id        String   @id @default(cuid())
  listId    String   @map("list_id")
  productId String   @map("product_id")
  quantity  Decimal  @db.Decimal(10, 3) @default(1)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  list    ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])

  @@unique([listId, productId])
  @@index([listId])
  @@map("shopping_list_items")
}

// ──────────────────────────────────────────────
// Reviews
// ──────────────────────────────────────────────

model Review {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  productId      String    @map("product_id")
  rating         Int       // 1..5
  comment        String?   @db.VarChar(1000)
  helpfulCount   Int       @default(0) @map("helpful_count")
  reportedCount  Int       @default(0) @map("reported_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  helpfuls ReviewHelpful[]

  @@unique([userId, productId])
  @@index([productId, deletedAt])
  @@index([createdAt])
  @@map("reviews")
}

model ReviewHelpful {
  id        String   @id @default(cuid())
  reviewId  String   @map("review_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@map("review_helpfuls")
}

// ──────────────────────────────────────────────
// Cesta Familiar
// ──────────────────────────────────────────────

model DietaryQuestion {
  id       String  @id @default(cuid())
  key      String  @unique
  labelEs  String  @map("label_es")
  labelPt  String  @map("label_pt")
  type     String  // "boolean" | "choice"
  options  Json?   // [{ value, labelEs, labelPt }] quando type=choice
  category String?
  order    Int     @default(0)

  @@map("dietary_questions")
}

model FamilyProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique @map("user_id")
  members            Json     // { babies, kids, children, teens, adults, seniors }
  answers            Json     // { eats_meat: true, eats_bread: true, ... }
  restrictions       String[] @default([])
  blockedCategories  String[] @default([]) @map("blocked_categories")
  requiredProductIds String[] @default([]) @map("required_product_ids")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  baskets FamilyBasket[]

  @@map("family_profiles")
}

model FamilyBasket {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  familyProfileId String    @map("family_profile_id")
  estimatedCost   Decimal   @db.Decimal(10, 2) @default(0) @map("estimated_cost")
  status          String    @default("pending") // pending | ready | failed
  errorMessage    String?   @map("error_message")
  generatedAt     DateTime  @default(now()) @map("generated_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile FamilyProfile      @relation(fields: [familyProfileId], references: [id])
  items   FamilyBasketItem[]

  @@index([userId, deletedAt])
  @@map("family_baskets")
}

model FamilyBasketItem {
  id         String  @id @default(cuid())
  basketId   String  @map("basket_id")
  productId  String  @map("product_id")
  quantity   Decimal @db.Decimal(10, 3)
  isRequired Boolean @default(false) @map("is_required")
  isLocked   Boolean @default(false) @map("is_locked")
  unitPrice  Decimal @db.Decimal(10, 2) @map("unit_price")
  position   Int     @default(0)

  basket  FamilyBasket @relation(fields: [basketId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])

  @@unique([basketId, productId])
  @@index([basketId])
  @@map("family_basket_items")
}

// ──────────────────────────────────────────────
// Catalog sync (ingestão de preços)
// ──────────────────────────────────────────────

model ProductCandidate {
  id              String   @id @default(cuid())
  rawName         String   @map("raw_name")
  normalizedName  String   @map("normalized_name")
  brand           String?
  ean             String?
  supermarketSlug String   @map("supermarket_slug")
  reportedPrice   Decimal  @db.Decimal(10, 2) @map("reported_price")
  packageHint     String?  @map("package_hint")
  categoryHint    String?  @map("category_hint")
  confirmations   Int      @default(1)
  status          String   @default("pending") // pending | approved | rejected
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([normalizedName, supermarketSlug])
  @@index([status, createdAt])
  @@map("product_candidates")
}

// ──────────────────────────────────────────────
// Receipts (OCR de notas fiscais)
// ──────────────────────────────────────────────

model Receipt {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  supermarketId   String?   @map("supermarket_id")
  supermarketSlug String?   @map("supermarket_slug")
  purchaseDate    DateTime? @map("purchase_date")
  total           Decimal?  @db.Decimal(10, 2)
  imageUrl        String?   @map("image_url")
  ocrRawText      String?   @map("ocr_raw_text") @db.Text
  status          String    @default("pending") // pending|processing|ready|failed
  errorMessage    String?   @map("error_message")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  supermarket Supermarket?       @relation(fields: [supermarketId], references: [id])
  items       ReceiptItem[]
  discrepancies PriceDiscrepancy[]

  @@index([userId, purchaseDate])
  @@index([userId, deletedAt])
  @@index([status])
  @@map("receipts")
}

model ReceiptItem {
  id             String   @id @default(cuid())
  receiptId      String   @map("receipt_id")
  rawText        String   @map("raw_text")
  normalizedName String   @map("normalized_name")
  quantity       Decimal  @db.Decimal(10, 3) @default(1)
  unitPrice      Decimal  @db.Decimal(10, 2) @map("unit_price")
  total          Decimal  @db.Decimal(10, 2)
  productId      String?  @map("product_id")
  categoryHint   String?  @map("category_hint")
  position       Int      @default(0)

  receipt Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([receiptId])
  @@index([productId])
  @@map("receipt_items")
}

model PriceDiscrepancy {
  id               String   @id @default(cuid())
  productPriceId   String   @map("product_price_id")
  reportedPrice    Decimal  @db.Decimal(10, 2) @map("reported_price")
  reportedByUserId String   @map("reported_by_user_id")
  receiptId        String?  @map("receipt_id")
  resolved         Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at")

  productPrice ProductPrice @relation(fields: [productPriceId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [reportedByUserId], references: [id])
  receipt      Receipt?     @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([productPriceId, resolved])
  @@map("price_discrepancies")
}

// ──────────────────────────────────────────────
// Alerts + notifications push
// ──────────────────────────────────────────────

model Alert {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  productId       String    @map("product_id")
  supermarketId   String?   @map("supermarket_id")
  type            String    // "promotion" | "target_price" | "promotion_ending" | "back_in_stock"
  targetPrice     Decimal?  @db.Decimal(10, 2) @map("target_price")
  isActive        Boolean   @default(true) @map("is_active")
  lastTriggeredAt DateTime? @map("last_triggered_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  supermarket Supermarket?   @relation(fields: [supermarketId], references: [id])
  triggers    AlertTrigger[]

  @@index([userId, isActive, deletedAt])
  @@index([productId, isActive])
  @@map("alerts")
}

model AlertTrigger {
  id            String    @id @default(cuid())
  alertId       String    @map("alert_id")
  reason        String    // "price_drop" | "promotion_started" | "target_reached" | ...
  priceSnapshot Decimal   @db.Decimal(10, 2) @map("price_snapshot")
  notifiedAt    DateTime? @map("notified_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, createdAt])
  @@map("alert_triggers")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  endpoint  String   @unique @db.Text
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model SyncRun {
  id              String    @id @default(cuid())
  supermarketSlug String    @map("supermarket_slug")
  status          String    @default("running") // running | success | partial | failed
  itemsProcessed  Int       @default(0) @map("items_processed")
  itemsCreated    Int       @default(0) @map("items_created")
  itemsUpdated    Int       @default(0) @map("items_updated")
  itemsCandidate  Int       @default(0) @map("items_candidate")
  itemsFailed     Int       @default(0) @map("items_failed")
  errorMessage    String?   @map("error_message")
  startedAt       DateTime  @default(now()) @map("started_at")
  finishedAt      DateTime? @map("finished_at")

  @@index([supermarketSlug, startedAt])
  @@map("sync_runs")
}
