{
  "name": "cesta-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "cross-env ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:gate": "vitest run --coverage --reporter=default",
    "test:ui": "vitest --ui",
    "i18n:parity": "node scripts/i18n-parity.mjs",
    "a11y:audit": "node scripts/a11y-audit.mjs",
    "a11y:audit:ci": "node scripts/a11y-audit.mjs --skip-build",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:report": "playwright show-report",
    "bundle:size": "node scripts/bundle-size.mjs",
    "types:api": "node scripts/generate-api-types.mjs",
    "types:api:check": "node scripts/generate-api-types.mjs --check"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
    "@radix-ui/react-slot": "^1.5.0",
    "@sentry/nextjs": "^11.12.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-devtools": "^5.107.1",
    "axios": "^1.21.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "next-intl": "^4.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "overrides": {
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.4.6",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "axe-core": "^4.14.1",
    "cross-env": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^29.1.1",
    "msw": "^3.0.5",
    "openapi-typescript": "^7.9.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
