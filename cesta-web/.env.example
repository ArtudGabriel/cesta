# Server-only API URL — usada pelos fetches SSR (RSC). Sem NEXT_PUBLIC_ prefix
# fica fora do bundle do client, evitando leak da URL interna/privada.
# Prod exemplo: https://cesta-api.onrender.com/api/v1 (ou URL interna Render)
API_URL=http://localhost:3001/api/v1

# Client-only (vaza no bundle intencionalmente) — usada pelas calls browser-side
# (axios em src/lib/api.ts). Pode apontar pra mesma URL publica da API em prod.
# Prod exemplo: https://cesta-api.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Secret compartilhado com cesta-api pra autenticar chamadas ao webhook
# POST /api/revalidate (invalidação de cache Next.js após catalog-sync).
# Prod: openssl rand -hex 32
REVALIDATE_SECRET=change-in-prod-via-openssl-rand-hex-32

# Sentry frontend (opcional — DSN do projeto Next.js separado do backend).
# Prod: criar projeto em sentry.io, copiar DSN público.
NEXT_PUBLIC_SENTRY_DSN=

# Sentry Performance tracing (Sprint 55). 0.0 = off, 1.0 = 100%, prod default 10%.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Sentry Session Replay (Sprint 58). Default 5% das sessões gravadas + 100%
# das que explodem. Privacy: inputs mascarados, mídia bloqueada.
NEXT_PUBLIC_SENTRY_REPLAY_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1.0

# Source maps upload (Sprint 55) — usados SÓ em CI build, não em runtime.
# Dev local: deixar vazio → build sem upload (sourcemaps.disable condicional).
# CI/Vercel: setar como secret.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
